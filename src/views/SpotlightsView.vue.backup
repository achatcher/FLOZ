<template>
  <div class="category-listing-view">
    <TopBar title="Announcements" :show-back="true" />

    <div class="listing-content">
      <!-- ===== HERO ANNOUNCEMENT (SIGNATURE TIER) ===== -->
      <div v-if="heroAnnouncement" class="hero-listing">
        <div class="hero-card" @click="openAnnouncement(heroAnnouncement)">
          <div class="hero-image-container">
            <img
              :src="heroAnnouncement.image"
              :alt="heroAnnouncement.title"
              class="hero-image"
              @error="handleImageError"
            />
          </div>
          <div class="hero-info">
            <h2 class="hero-name">{{ heroAnnouncement.title }}</h2>
            <p class="hero-description">{{ heroAnnouncement.excerpt }}</p>
            <div class="hero-features">
              <span class="hero-category">{{ heroAnnouncement.category }}</span>
              <span class="hero-price">{{ formatDate(heroAnnouncement.publishDate) }}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== FEATURED ANNOUNCEMENTS (PREMIER TIER) ===== -->
      <div v-if="featuredAnnouncements.length > 0" class="featured-section">
        <h3 class="section-title">Featured Updates</h3>
        <div class="featured-grid">
          <div
            v-for="announcement in featuredAnnouncements"
            :key="announcement.id"
            class="featured-card"
            @click="openAnnouncement(announcement)"
          >
            <div class="featured-image-container">
              <img
                :src="announcement.image"
                :alt="announcement.title"
                class="featured-image"
                @error="handleImageError"
              />
            </div>
            <div class="featured-info">
              <h4 class="featured-name">{{ announcement.title }}</h4>
              <p class="featured-category">{{ announcement.category }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== STANDARD ANNOUNCEMENTS (CURATED TIER) ===== -->
      <div v-if="standardAnnouncements.length > 0" class="standard-section">
        <h3 class="section-title">All Announcements</h3>
        <div class="standard-list">
          <div
            v-for="announcement in standardAnnouncements"
            :key="announcement.id"
            class="standard-item"
            @click="openAnnouncement(announcement)"
          >
            <div class="standard-image-wrapper">
              <img
                :src="announcement.image"
                :alt="announcement.title"
                class="standard-image"
                @error="handleImageError"
              />
            </div>
            <div class="standard-content">
              <h4 class="standard-title">{{ announcement.title }}</h4>
              <p class="standard-subtitle">{{ announcement.category }}</p>
              <div class="standard-meta">
                <span class="standard-price">{{ formatDate(announcement.publishDate) }}</span>
                <span class="tier-badge curated">CURATED</span>
              </div>
            </div>
            <div class="standard-arrow">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M8.59 16.59L13.17 12L8.59 7.41L10 6L16 12L10 18L8.59 16.59Z"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Loading State -->
      <div v-if="loading" class="loading-state">
        <div class="loading-icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 6V9L16 5L12 1V4C7.58 4 4 7.58 4 12S7.58 20 12 20 20 16.42 20 12H18C18 15.31 15.31 18 12 18S6 15.31 6 12 8.69 6 12 6Z"/>
          </svg>
        </div>
        <h3 class="loading-title">Loading...</h3>
        <p class="loading-text">Getting the latest community updates.</p>
      </div>

      <!-- Empty State -->
      <div v-else-if="!heroAnnouncement && featuredAnnouncements.length === 0 && standardAnnouncements.length === 0 && !loading" class="empty-state">
        <div class="empty-icon">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L13.09 8.26L22 9L13.09 9.74L12 22L10.91 9.74L2 9L10.91 8.26L12 2Z"/>
          </svg>
        </div>
        <h3 class="empty-title">Coming Soon</h3>
        <p class="empty-text">New community announcements will appear here.</p>
      </div>
    </div>

    <BottomNav />

    <!-- Announcement Modal -->
    <BusinessModal
      :business="selectedAnnouncement"
      :is-visible="showAnnouncementModal"
      @close="closeAnnouncementModal"
    />
  </div>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue'
import TopBar from '@/components/Navigation/TopBar.vue'
import BottomNav from '@/components/Navigation/BottomNav.vue'
import BusinessModal from '@/components/Business/BusinessModal.vue'
import { useBusinessStore } from '@/stores/businessStore'
import { useAppConfig } from '@/composables/useAppConfig'

// Reactive data
const announcements = ref([])
const selectedAnnouncement = ref(null)
const showAnnouncementModal = ref(false)
const loading = ref(false)

// Store and config setup
const businessStore = useBusinessStore()
const { initializeApp, getCurrentBusinesses, getConfig } = useAppConfig()

// ===== THREE-TIER ANNOUNCEMENT STRUCTURE =====

/**
 * HERO TIER: Featured announcement with largest display
 */
const heroAnnouncement = computed(() => {
  return announcements.value.find(announcement =>
    announcement.tier === 'signature' || announcement.featured
  ) || null
})

/**
 * PREMIER TIER: Featured announcements in grid layout
 */
const featuredAnnouncements = computed(() => {
  return announcements.value.filter(announcement =>
    (announcement.tier === 'premier' || announcement.priority === 'high') &&
    announcement.id !== heroAnnouncement.value?.id
  )
})

/**
 * CURATED TIER: Standard announcements in list format
 */
const standardAnnouncements = computed(() => {
  return announcements.value.filter(announcement => {
    const isHero = announcement.id === heroAnnouncement.value?.id
    const isFeatured = featuredAnnouncements.value.some(featured => featured.id === announcement.id)
    return !isHero && !isFeatured
  })
})

// Methods
const openAnnouncement = (announcement) => {
  // Transform announcement to business-like structure for modal compatibility
  selectedAnnouncement.value = {
    ...announcement,
    name: announcement.title,
    category: announcement.category,
    description: announcement.content?.replace(/<[^>]*>/g, '').substring(0, 200) + '...' || announcement.excerpt,
    contact: {
      phone: null,
      website: null,
      email: null,
      address: 'Greenville, SC'
    },
    features: {
      community_update: true
    }
  }
  showAnnouncementModal.value = true
}

const closeAnnouncementModal = () => {
  showAnnouncementModal.value = false
  selectedAnnouncement.value = null
}

const formatDate = (dateString) => {
  const date = new Date(dateString)
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  })
}

const handleImageError = (e) => {
  e.target.src = 'data:image/svg+xml;base64,'
}

const loadAnnouncements = async () => {
  try {
    // Initialize app configuration
    await initializeApp()
    await businessStore.loadData()

    const businesses = getCurrentBusinesses.value || []
    const config = getConfig.value || {}
    const locationName = config.location || 'Greenville'

    // Generate dynamic announcements based on available businesses and location
    const generatedAnnouncements = []

    // Create signature tier announcements from signature businesses
    const signatureBusinesses = businesses.filter(b => b.tier === 'signature').slice(0, 2)
    signatureBusinesses.forEach((business, index) => {
      generatedAnnouncements.push({
        id: `sig-${business.id}`,
        title: `Featured Partner: ${business.name}`,
        excerpt: business.description || `Discover the exceptional experience at ${business.name}, one of ${locationName}'s premier destinations.`,
        category: business.category,
        subcategory: business.subcategory || 'Featured Business',
        author: business.name,
        publishDate: new Date().toISOString().split('T')[0],
        image: business.heroImage || business.image || business.logo || 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&h=400&fit=crop&crop=center',
        tier: 'signature',
        featured: true,
        priority: 'high',
        price_range: business.priceRange || 'Contact for pricing',
        contact: business.contact || {},
        features: business.features ? Object.fromEntries(business.features.map(f => [f.toLowerCase().replace(/\s+/g, '_'), true])) : {},
        content: `
          <p>${business.description || `Experience the best that ${locationName} has to offer at ${business.name}.`}</p>

          ${business.features ? `<h3>Features</h3><ul>${business.features.map(f => `<li>${f}</li>`).join('')}</ul>` : ''}

          ${business.hours ? `<h3>Hours</h3><p>Visit us during our regular business hours for the best experience.</p>` : ''}

          <h3>Contact Information</h3>
          <p>For more information, please contact ${business.name} directly.</p>
        `
      })
    })

    // Create premier tier announcements from premier businesses
    const premierBusinesses = businesses.filter(b => b.tier === 'premier').slice(0, 2)
    premierBusinesses.forEach((business, index) => {
      generatedAnnouncements.push({
        id: `prem-${business.id}`,
        title: `Now Featured: ${business.name}`,
        excerpt: business.description || `${business.name} brings exceptional ${business.category.toLowerCase()} to ${locationName}.`,
        category: business.category,
        subcategory: business.subcategory || 'Premier Business',
        author: business.name,
        publishDate: new Date(Date.now() - (index + 1) * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
        image: business.heroImage || business.image || business.logo || 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=800&h=400&fit=crop&crop=center',
        tier: 'premier',
        featured: true,
        priority: 'medium',
        price_range: business.priceRange || 'Varies',
        contact: business.contact || {},
        features: business.features ? Object.fromEntries(business.features.map(f => [f.toLowerCase().replace(/\s+/g, '_'), true])) : {},
        content: `
          <p>Discover what makes ${business.name} a standout destination in ${locationName}'s ${business.category.toLowerCase()} scene.</p>

          ${business.features ? `<h3>What We Offer</h3><ul>${business.features.map(f => `<li>${f}</li>`).join('')}</ul>` : ''}

          <h3>Visit Us</h3>
          <p>Located in ${business.location?.neighborhood || locationName}, ${business.name} welcomes you to experience our ${business.subcategory || business.category.toLowerCase()}.</p>
        `
      })
    })

    // Create curated tier announcements from curated businesses
    const curatedBusinesses = businesses.filter(b => b.tier === 'curated').slice(0, 1)
    curatedBusinesses.forEach((business, index) => {
      generatedAnnouncements.push({
        id: `cur-${business.id}`,
        title: `Community Spotlight: ${business.name}`,
        excerpt: business.description || `${business.name} is a valued part of the ${locationName} community.`,
        category: business.category,
        subcategory: business.subcategory || 'Community Business',
        author: business.name,
        publishDate: new Date(Date.now() - (index + 3) * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
        image: business.heroImage || business.image || business.logo || 'https://images.unsplash.com/photo-1579871494447-9811cf80d66c?w=800&h=400&fit=crop&crop=center',
        tier: 'curated',
        featured: false,
        priority: 'low',
        price_range: business.priceRange || 'Affordable',
        contact: business.contact || {},
        features: business.features ? Object.fromEntries(business.features.map(f => [f.toLowerCase().replace(/\s+/g, '_'), true])) : {},
        content: `
          <p>${business.name} represents the best of ${locationName}'s local ${business.category.toLowerCase()} offerings.</p>

          <h3>About ${business.name}</h3>
          <p>${business.description || `Located in ${business.location?.neighborhood || locationName}, we're committed to serving our community.`}</p>

          <h3>Visit Us Today</h3>
          <p>Experience what makes ${business.name} special in the ${locationName} community.</p>
        `
      })
    })

    announcements.value = generatedAnnouncements

  } catch (error) {
    console.error('Failed to load dynamic announcements:', error)
    // Fallback to empty array if dynamic loading fails
    announcements.value = []
  }
}

// Lifecycle
      author: "City of Greenville",
      publishDate: "2024-11-15",
      image: "https://images.unsplash.com/photo-1512389142860-9c449e58a543?w=800&h=400&fit=crop&crop=center",
      tier: "signature",
      featured: true,
      priority: "high",
      price_range: "Free",
      contact: {
        phone: "(864) 467-4350",
        website: "https://greenvillesc.gov",
        email: "events@greenvillesc.gov",
        address: "Falls Park on the Reedy, Greenville, SC"
      },
      features: {
        family_friendly: true,
        free_admission: true,
        holiday_tradition: true,
        live_music: true,
        photo_opportunities: true
      },
      content: `
        <p>Mark your calendars for Greenville's most beloved holiday tradition! The annual Holiday Tree Lighting Ceremony will take place at Falls Park on the Reedy on Friday, December 1st at 6:00 PM.</p>

        <h3>Event Highlights</h3>
        <ul>
          <li>Live performances by local school choirs and the Greenville Symphony Orchestra</li>
          <li>Complimentary hot cocoa and holiday treats</li>
          <li>Special appearances by Santa Claus and holiday characters</li>
          <li>Professional holiday photos at the Liberty Bridge</li>
          <li>Local artisan holiday market</li>
        </ul>

        <h3>Getting There</h3>
        <p>Free parking will be available in downtown lots after 5:00 PM. We encourage carpooling or using the Greenville trolley service, which will run extended hours for the event.</p>

        <p>The event is free and open to all ages. In case of inclement weather, the ceremony will move to the Peace Center for the Performing Arts.</p>

        <p>For more information, visit greenvillesc.gov or call (864) 467-4350.</p>
      `
    },
    {
      id: 2,
      title: "Peace Center Broadway Series Announces 2025 Season",
      excerpt: "Six spectacular Broadway shows coming to Greenville, including Hamilton, The Lion King, and Wicked. Season packages on sale now.",
      category: "Entertainment",
      subcategory: "Broadway Shows",
      author: "Peace Center",
      publishDate: "2024-11-05",
      image: "https://images.unsplash.com/photo-1541961017774-22349e4a1262?w=800&h=400&fit=crop&crop=center",
      tier: "premier",
      featured: false,
      priority: "high",
      price_range: "$$$",
      contact: {
        phone: "(864) 467-3000",
        website: "https://peacecenter.org",
        email: "tickets@peacecenter.org",
        address: "Peace Center, Downtown Greenville, SC"
      },
      features: {
        broadway_shows: true,
        season_packages: true,
        premium_entertainment: true,
        cultural_events: true
      },
      content: `
        <p>The Peace Center for the Performing Arts is thrilled to announce the 2025 Broadway Series, featuring six world-class productions that will grace the stage throughout the year.</p>

        <h3>2025 Broadway Lineup</h3>
        <ul>
          <li><strong>Hamilton</strong> - March 12-24, 2025</li>
          <li><strong>The Lion King</strong> - May 14-26, 2025</li>
          <li><strong>Wicked</strong> - July 16-28, 2025</li>
          <li><strong>Chicago</strong> - September 10-22, 2025</li>
          <li><strong>The Phantom of the Opera</strong> - October 15-27, 2025</li>
          <li><strong>Dear Evan Hansen</strong> - December 3-15, 2025</li>
        </ul>

        <h3>Season Package Benefits</h3>
        <p>Season subscribers enjoy priority seating, exchange privileges, special discounts at partner restaurants, and exclusive behind-the-scenes events with cast and crew.</p>

        <p>Individual show tickets go on sale to the general public starting January 15th, 2025. Season packages are available now at peacecenter.org or by calling the box office at (864) 467-3000.</p>
      `
    },
    {
      id: 3,
      title: "Artisphere 2025 Artist Applications Now Open",
      excerpt: "Local and regional artists invited to participate in Greenville's premier outdoor art festival. Application deadline is January 31st, 2025.",
      category: "Arts & Culture",
      subcategory: "Art Festival",
      author: "Artisphere Committee",
      publishDate: "2024-11-08",
      image: "https://images.unsplash.com/photo-1541961017774-22349e4a1262?w=800&h=400&fit=crop&crop=center",
      tier: "premier",
      featured: false,
      priority: "high",
      price_range: "$",
      contact: {
        phone: "(864) 271-9398",
        website: "https://artisphere.org",
        email: "artists@artisphere.org",
        address: "Main Street Cultural District, Greenville, SC"
      },
      features: {
        artist_applications: true,
        outdoor_festival: true,
        local_artists: true,
        cultural_events: true
      },
      content: `
        <p>Artisphere, Greenville's beloved outdoor art festival, is accepting applications for the 2025 event scheduled for May 9-11 in downtown Greenville's Main Street Cultural District.</p>

        <h3>Categories & Requirements</h3>
        <ul>
          <li><strong>Visual Arts:</strong> Painting, photography, sculpture, mixed media</li>
          <li><strong>Functional Arts:</strong> Pottery, jewelry, textiles, woodworking</li>
          <li><strong>Performing Arts:</strong> Musicians, dancers, theatrical performers</li>
          <li><strong>Culinary Arts:</strong> Food vendors and artisanal food producers</li>
        </ul>

        <h3>What's New</h3>
        <p>This year features expanded youth artist showcases, interactive art installations, and a new "Local Spotlight" section highlighting Greenville County artists.</p>

        <p>Application fee is $35 for visual artists and $50 for food vendors. Booth spaces range from $200-500 depending on location and category. Apply online at artisphere.org by January 31st, 2025.</p>

        <p>For questions, contact the Artisphere team at artists@artisphere.org or (864) 271-9398.</p>
      `
    },
    {
      id: 4,
      title: "Swamp Rabbit Trail Winter Maintenance Schedule",
      excerpt: "Important updates on trail closures and maintenance work along the Swamp Rabbit Trail during November and December.",
      category: "Parks & Recreation",
      subcategory: "Trail Updates",
      author: "Greenville County Parks",
      publishDate: "2024-11-12",
      image: "https://images.unsplash.com/photo-1544966503-7cc5ac882d5c?w=800&h=400&fit=crop&crop=center",
      tier: "curated",
      featured: false,
      priority: "medium",
      price_range: "Free",
      contact: {
        phone: "(864) 467-4355",
        website: "https://greenvilletrails.com",
        email: "trails@greenvillecounty.org",
        address: "Swamp Rabbit Trail, Greenville County, SC"
      },
      features: {
        trail_maintenance: true,
        public_safety: true,
        outdoor_recreation: true,
        community_update: true
      },
      content: `
        <p>The Swamp Rabbit Trail will undergo scheduled winter maintenance from November 20th through December 10th. Please note the following temporary closures and detours:</p>

        <h3>Affected Sections</h3>
        <ul>
          <li><strong>Mile 4-6 (Downtown to Cleveland Park):</strong> Resurfacing work, trail closed weekdays 8 AM - 4 PM</li>
          <li><strong>Mile 12-14 (Travelers Rest section):</strong> Bridge inspection and repairs, closed November 25-27</li>
          <li><strong>Furman University connector:</strong> Temporary detour via Poinsett Highway sidewalk</li>
        </ul>

        <h3>Safety Reminders</h3>
        <p>During maintenance periods, please observe all posted signage and use designated detour routes. Trail users should exercise extra caution in work zones and around maintenance equipment.</p>

        <p>For real-time trail updates and conditions, visit greenvilletrails.com or follow @SwampRabbitTrail on social media.</p>
      `
    },
    {
      id: 5,
      title: "Greenville Drive Season Ticket Renewals Now Open",
      excerpt: "Secure your seats for the 2025 baseball season at Fluor Field. Early bird pricing available through December 15th.",
      category: "Sports",
      subcategory: "Baseball",
      author: "Greenville Drive",
      publishDate: "2024-11-10",
      image: "https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&h=400&fit=crop&crop=center",
      tier: "curated",
      featured: false,
      priority: "medium",
      price_range: "$$",
      contact: {
        phone: "(864) 240-4528",
        website: "https://milb.com/greenville",
        email: "tickets@greenvilledrive.com",
        address: "Fluor Field at the West End, Greenville, SC"
      },
      features: {
        season_tickets: true,
        early_bird_pricing: true,
        family_entertainment: true,
        professional_sports: true
      },
      content: `
        <p>The Greenville Drive is excited to announce that 2025 season ticket renewals are now available! Don't miss another exciting season of minor league baseball at beautiful Fluor Field at the West End.</p>

        <h3>Early Bird Benefits</h3>
        <ul>
          <li>10% discount on season ticket packages renewed before December 15th</li>
          <li>Priority access to playoff tickets</li>
          <li>Exclusive season ticket holder events and meet-and-greets</li>
          <li>Free parking passes for select package levels</li>
        </ul>

        <h3>New for 2025</h3>
        <p>Enhanced food and beverage options, upgraded stadium WiFi, and new premium seating areas behind home plate. Plus, enjoy the return of popular promotions like Dollar Hot Dog Night and Fireworks Fridays.</p>

        <p>To renew or purchase new season tickets, visit milb.com/greenville, call (864) 240-4528, or stop by the Fluor Field box office. Group packages for businesses and organizations are also available.</p>
      `
    }
  ]
}

// Lifecycle
onMounted(() => {
  loadAnnouncements()
})
</script>

<style src="../assets/styles/pages/category-listing.css" scoped></style>